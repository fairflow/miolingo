{
 "language": "en",
 "variant": "en-gb",
 "phrases": [
  {"text": "Yes", "gloss": "Oui", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-001.txt", "ipa": [["j", "ɛ", "s"]]},
  {"text": "Good evening", "gloss": "Bonsoir", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-001.txt", "ipa": [["ɡ", "ʊ", "d"], ["iː", "v", "n", "ɪ", "ŋ"]]},
  {"text": "Excuse me", "gloss": "Excusez-moi", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-001.txt", "ipa": [["ɛ", "k", "s", "k", "j", "uː", "s"], ["m", "iː"]]},
  {"text": "And you?", "gloss": "Et vous?", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-001.txt", "ipa": [["a", "n", "d"], ["j", "uː"]], "note": "formal"},
  {"text": "Have a good evening", "gloss": "Bonne soirée", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-001.txt", "ipa": [["h", "a", "v"], ["ɐ"], ["ɡ", "ʊ", "d"], ["iː", "v", "n", "ɪ", "ŋ"]]},
  {"text": "Okay", "gloss": "D'accord", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-001.txt", "ipa": [["ə", "ʊ", "k", "e", "ɪ"]], "note": "also: Agreed"},
  {"text": "I don't know", "gloss": "Je ne sais pas", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-001.txt", "ipa": [["a", "ɪ"], ["d", "ə", "ʊ", "n", "t"], ["n", "ə", "ʊ"]]},
  {"text": "Watch out", "gloss": "Attention", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-001.txt", "ipa": [["w", "ɒ", "t", "ʃ"], ["a", "ʊ", "t"]], "note": "also: Careful"},
  {"text": "Cheers", "gloss": "Santé", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-001.txt", "ipa": [["t", "ʃ", "i", "ə", "z"]], "note": "also: Bless you"},
  {"text": "Good luck", "gloss": "Bon courage", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-001.txt", "ipa": [["ɡ", "ʊ", "d"], ["l", "ʌ", "k"]], "note": "also: Hang in there"},
  {"text": "With pleasure", "gloss": "Avec plaisir", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-001.txt", "ipa": [["w", "ɪ", "ð"], ["p", "l", "ɛ", "ʒ", "ə"]]},
  {"text": "One moment", "gloss": "Un moment", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-001.txt", "ipa": [["w", "ɒ", "n"], ["m", "ə", "ʊ", "m", "ə", "n", "t"]]},
  {"text": "How are you?", "gloss": "Comment ça va?", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-003.txt", "ipa": [["h", "a", "ʊ"], ["ɑː"], ["j", "uː"]], "note": "informal"},
  {"text": "What's your name?", "gloss": "Tu t'appelles comment?", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-003.txt", "ipa": [["w", "ɒ", "t", "s"], ["j", "ɔː"], ["n", "e", "ɪ", "m"]], "note": "informal"},
  {"text": "I live in London", "gloss": "J'habite à Londres", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-003.txt", "ipa": [["a", "ɪ"], ["l", "ɪ", "v"], ["ɪ", "n"], ["l", "ʌ", "n", "d", "ə", "n"]]},
  {"text": "I don't understand", "gloss": "Je ne comprends pas", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-003.txt", "ipa": [["a", "ɪ"], ["d", "ə", "ʊ", "n", "t"], ["ʌ", "n", "d", "ə", "s", "t", "a", "n", "d"]]},
  {"text": "What is this?", "gloss": "Qu'est-ce que c'est?", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-003.txt", "ipa": [["w", "ɒ", "t"], ["ɪ", "z"], ["ð", "ɪ", "s"]]},
  {"text": "Where is it?", "gloss": "C'est où?", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-003.txt", "ipa": [["w", "e", "ə", "ɹ"], ["ɪ", "z"], ["ɪ", "t"]]},
  {"text": "Straight ahead", "gloss": "Tout droit", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-003.txt", "ipa": [["s", "t", "ɹ", "e", "ɪ", "t"], ["ɐ", "h", "ɛ", "d"]]},
  {"text": "Next to", "gloss": "À côté de", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-003.txt", "ipa": [["n", "ɛ", "k", "s", "t"], ["t", "uː"]]},
  {"text": "Do you have...?", "gloss": "Avez-vous...?", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-003.txt", "ipa": [["d", "uː"], ["j", "uː"], ["h", "a", "v"]]},
  {"text": "Can you help me?", "gloss": "Pouvez-vous m'aider?", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-003.txt", "ipa": [["k", "a", "n"], ["j", "uː"], ["h", "ɛ", "l", "p"], ["m", "iː"]]},
  {"text": "Today", "gloss": "Aujourd'hui", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-003.txt", "ipa": [["t", "ə", "d", "e", "ɪ"]]},
  {"text": "Later", "gloss": "Plus tard", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-003.txt", "ipa": [["l", "e", "ɪ", "t", "ə"]]},
  {"text": "I'm lost", "gloss": "Je suis perdu", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-004.txt", "ipa": [["a", "ɪ", "m"], ["l", "ɒ", "s", "t"]], "note": "m"},
  {"text": "Where is the bus stop?", "gloss": "Où est l'arrêt de bus?", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-004.txt", "ipa": [["w", "e", "ə", "ɹ"], ["ɪ", "z"], ["ð", "ə"], ["b", "ʌ", "s"], ["s", "t", "ɒ", "p"]]},
  {"text": "The train is late", "gloss": "Le train est en retard", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-004.txt", "ipa": [["ð", "ə"], ["t", "ɹ", "e", "ɪ", "n"], ["ɪ", "z"], ["l", "e", "ɪ", "t"]]},
  {"text": "For how many nights?", "gloss": "Pour combien de nuits?", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-004.txt", "ipa": [["f", "ɔː"], ["h", "a", "ʊ"], ["m", "ɛ", "n", "i"], ["n", "a", "ɪ", "t", "s"]]},
  {"text": "Can you wake me at seven o'clock?", "gloss": "Pouvez-vous me réveiller à sept heures?", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-004.txt", "ipa": [["k", "a", "n"], ["j", "uː"], ["w", "e", "ɪ", "k"], ["m", "iː"], ["a", "t"], ["s", "ɛ", "v", "ə", "n"], ["ə", "k", "l", "ɒ", "k"]]},
  {"text": "A table for two people", "gloss": "Une table pour deux personnes", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-004.txt", "ipa": [["ɐ"], ["t", "e", "ɪ", "b", "ə", "l"], ["f", "ɔː"], ["t", "uː"], ["p", "iː", "p", "ə", "l"]]},
  {"text": "I'm allergic to peanuts", "gloss": "Je suis allergique aux arachides", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-004.txt", "ipa": [["a", "ɪ", "m"], ["ɐ", "l", "ɜː", "d", "ʒ", "ɪ", "k"], ["t", "ə"], ["p", "iː", "n", "ʌ", "t", "s"]]},
  {"text": "Can I pay by card?", "gloss": "Je peux payer par carte?", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-004.txt", "ipa": [["k", "a", "n"], ["a", "ɪ"], ["p", "e", "ɪ"], ["b", "a", "ɪ"], ["k", "ɑː", "d"]]},
  {"text": "Do you have a larger size?", "gloss": "Avez-vous une taille plus grande?", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-004.txt", "ipa": [["d", "uː"], ["j", "uː"], ["h", "a", "v"], ["ɐ"], ["l", "ɑː", "d", "ʒ", "ə"], ["s", "a", "ɪ", "z"]]},
  {"text": "Can you gift-wrap it?", "gloss": "Pouvez-vous faire un paquet-cadeau?", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-004.txt", "ipa": [["k", "a", "n"], ["j", "uː"], ["ɡ", "ɪ", "f", "t", "ɹ", "a", "p"], ["ɪ", "t"]]},
  {"text": "I have a stomachache", "gloss": "J'ai mal au ventre", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-004.txt", "ipa": [["a", "ɪ"], ["h", "a", "v"], ["ɐ"], ["s", "t", "ʌ", "m", "ə", "k", "e", "ɪ", "k"]]},
  {"text": "I need a prescription", "gloss": "J'ai besoin d'une ordonnance", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-004.txt", "ipa": [["a", "ɪ"], ["n", "iː", "d"], ["ɐ"], ["p", "ɹ", "ɪ", "s", "k", "ɹ", "ɪ", "p", "ʃ", "ə", "n"]]},
  {"text": "I would like to make an appointment", "gloss": "Je voudrais prendre rendez-vous", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-005.txt", "ipa": [["a", "ɪ"], ["w", "ʊ", "d"], ["l", "a", "ɪ", "k"], ["t", "ə"], ["m", "e", "ɪ", "k"], ["ɐ", "n"], ["ɐ", "p", "ɔ", "ɪ", "n", "t", "m", "ə", "n", "t"]]},
  {"text": "Are there cancellation fees?", "gloss": "Y a-t-il des frais d'annulation?", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-005.txt", "ipa": [["ɑː"], ["ð", "e", "ə"], ["k", "a", "n", "s", "ɪ", "l", "e", "ɪ", "ʃ", "ə", "n"], ["f", "iː", "z"]]},
  {"text": "When is the next flight?", "gloss": "Quand est le prochain vol?", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-005.txt", "ipa": [["w", "ɛ", "n"], ["ɪ", "z"], ["ð", "ə"], ["n", "ɛ", "k", "s", "t"], ["f", "l", "a", "ɪ", "t"]]},
  {"text": "I would like to file a complaint", "gloss": "Je voudrais déposer une réclamation", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-005.txt", "ipa": [["a", "ɪ"], ["w", "ʊ", "d"], ["l", "a", "ɪ", "k"], ["t", "ə"], ["f", "a", "ɪ", "l"], ["ɐ"], ["k", "ə", "m", "p", "l", "e", "ɪ", "n", "t"]]},
  {"text": "I'm looking for an apartment to rent", "gloss": "Je cherche un appartement à louer", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-005.txt", "ipa": [["a", "ɪ", "m"], ["l", "ʊ", "k", "ɪ", "ŋ"], ["f", "ɔː"], ["a", "n"], ["ɐ", "p", "ɑː", "t", "m", "ə", "n", "t"], ["t", "uː"], ["ɹ", "ɛ", "n", "t"]]},
  {"text": "Is the neighborhood safe?", "gloss": "Le quartier est-il sûr?", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-005.txt", "ipa": [["ɪ", "z"], ["ð", "ə"], ["n", "e", "ɪ", "b", "ə", "h", "ʊ", "d"], ["s", "e", "ɪ", "f"]]},
  {"text": "When can I start?", "gloss": "Quand puis-je commencer?", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-005.txt", "ipa": [["w", "ɛ", "n"], ["k", "a", "n"], ["a", "ɪ"], ["s", "t", "ɑː", "t"]]},
  {"text": "Are there monthly fees?", "gloss": "Y a-t-il des frais mensuels?", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-005.txt", "ipa": [["ɑː"], ["ð", "e", "ə"], ["m", "ʌ", "n", "θ", "l", "i"], ["f", "iː", "z"]]},
  {"text": "How long does the transfer take?", "gloss": "Combien de temps prend le virement?", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-005.txt", "ipa": [["h", "a", "ʊ"], ["l", "ɒ", "ŋ"], ["d", "ʌ", "z"], ["ð", "ə"], ["t", "ɹ", "a", "n", "s", "f", "ɜː"], ["t", "e", "ɪ", "k"]]},
  {"text": "Someone used my card without authorization", "gloss": "Quelqu'un a utilisé ma carte sans autorisation", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-005.txt", "ipa": [["s", "ʌ", "m", "w", "ɒ", "n"], ["j", "uː", "z", "d"], ["m", "a", "ɪ"], ["k", "ɑː", "d"], ["w", "ɪ", "ð", "a", "ʊ", "t"], ["ɔː", "θ", "ə", "ɹ", "a", "ɪ", "z", "e", "ɪ", "ʃ", "ə", "n"]]},
  {"text": "The PIN code doesn't work", "gloss": "Le code PIN ne fonctionne pas", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-005.txt", "ipa": [["ð", "ə"], ["p", "iː", "a", "ɪ", "ɛ", "n"], ["k", "ə", "ʊ", "d"], ["d", "ʌ", "z", "ə", "n", "t"], ["w", "ɜː", "k"]]},
  {"text": "I would like to take out insurance", "gloss": "Je souhaiterais souscrire à une assurance", "gloss_language": "fr", "source": "language_materials/en/phrases/phrases-005.txt", "ipa": [["a", "ɪ"], ["w", "ʊ", "d"], ["l", "a", "ɪ", "k"], ["t", "ə"], ["t", "e", "ɪ", "k"], ["a", "ʊ", "t"], ["ɪ", "n", "ʃ", "ʊ", "ə", "ɹ", "ə", "n", "s"]]}
