 "phrases": [
  {"text": "Ja", "gloss": "Yes", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-001.txt", "ipa": [["j", "ɑ"]]},
  {"text": "Guten Abend", "gloss": "Good evening", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-001.txt", "ipa": [["ɡ", "u", "t", "ə", "n"], ["ɑ", "b", "ə", "n", "t"]]},
  {"text": "Entschuldigen Sie", "gloss": "Excuse me", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-001.txt", "ipa": [["ɛ", "n", "t", "ʃ", "ʊ", "l", "d", "ɪ", "ɡ", "ə", "n"], ["z", "i"]]},
  {"text": "Und Ihnen?", "gloss": "And you? (formal)", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-001.txt", "ipa": [["ʊ", "n", "t"], ["i", "n", "ə", "n"]]},
  {"text": "Einen schönen Abend noch", "gloss": "Have a good evening", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-001.txt", "ipa": [["a", "ɪ", "n", "ə", "n"], ["ʃ", "ø", "n", "ə", "n"], ["ɑ", "b", "ə", "n", "t"], ["n", "ɔ", "x"]]},
  {"text": "Einverstanden", "gloss": "Okay / Agreed", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-001.txt", "ipa": [["a", "ɪ", "n", "f", "ɛ", "ɾ", "ʃ", "t", "a", "n", "d", "ə", "n"]]},
  {"text": "Ich weiß nicht", "gloss": "I don't know", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-001.txt", "ipa": [["ɪ", "ç"], ["v", "a", "ɪ", "s"], ["n", "ɪ", "ç", "t"]]},
  {"text": "Achtung", "gloss": "Watch out / Careful", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-001.txt", "ipa": [["a", "x", "t", "ʊ", "ŋ"]]},
  {"text": "Prost", "gloss": "Cheers / Bless you", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-001.txt", "ipa": [["p", "ɾ", "ɔ", "s", "t"]]},
  {"text": "Viel Glück", "gloss": "Good luck / Hang in there", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-001.txt", "ipa": [["f", "i", "l"], ["ɡ", "l", "y", "k"]]},
  {"text": "Mit Vergnügen", "gloss": "With pleasure", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-001.txt", "ipa": [["m", "ɪ", "t"], ["f", "ɛ", "ɾ", "ɡ", "ə", "n", "y", "ɡ", "ə", "n"]]},
  {"text": "Einen Moment bitte", "gloss": "One moment", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-001.txt", "ipa": [["a", "ɪ", "n", "ə", "n"], ["m", "o", "m", "ɛ", "n", "t"], ["b", "ɪ", "t", "ə"]]},
  {"text": "Wie geht's?", "gloss": "How are you? (informal)", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-003.txt", "ipa": [["v", "i"], ["ɡ", "e", "t", "s"]]},
  {"text": "Wie heißen Sie?", "gloss": "What is your name? (formal)", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-003.txt", "ipa": [["v", "i"], ["h", "a", "ɪ", "s", "ə", "n"], ["z", "i"]]},
  {"text": "Ich wohne in London", "gloss": "I live in London", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-003.txt", "ipa": [["ɪ", "ç"], ["v", "o", "n", "ə"], ["ɪ", "n"], ["l", "ɔ", "n", "d", "o", "n"]]},
  {"text": "Ich verstehe nicht", "gloss": "I don't understand", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-003.txt", "ipa": [["ɪ", "ç"], ["f", "ɛ", "ɾ", "ʃ", "t", "e", "ə"], ["n", "ɪ", "ç", "t"]]},
  {"text": "Was ist das?", "gloss": "What is this?", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-003.txt", "ipa": [["v", "a", "s"], ["ɪ", "s", "t"], ["d", "a", "s"]]},
  {"text": "Wo ist es?", "gloss": "Where is it?", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-003.txt", "ipa": [["v", "o"], ["ɪ", "s", "t"], ["ɛ", "s"]]},
  {"text": "Geradeaus", "gloss": "Straight ahead", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-003.txt", "ipa": [["ɡ", "ə", "r", "ɑ", "d", "e", "a", "ʊ", "s"]]},
  {"text": "Neben", "gloss": "Next to", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-003.txt", "ipa": [["n", "e", "b", "ə", "n"]]},
  {"text": "Haben Sie...?", "gloss": "Do you have...?", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-003.txt", "ipa": [["h", "ɑ", "b", "ə", "n"], ["z", "i"]]},
  {"text": "Können Sie mir helfen?", "gloss": "Can you help me?", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-003.txt", "ipa": [["k", "œ", "n", "ə", "n"], ["z", "i"], ["m", "i", "ɾ"], ["h", "ɛ", "l", "f", "ə", "n"]]},
  {"text": "Heute", "gloss": "Today", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-003.txt", "ipa": [["h", "ɔ", "ø", "t", "ə"]]},
  {"text": "Später", "gloss": "Later", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-003.txt", "ipa": [["ʃ", "p", "ɛ", "t", "ɜ"]]},
  {"text": "Ich habe mich verirrt", "gloss": "I'm lost (m)", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-004.txt", "ipa": [["ɪ", "ç"], ["h", "ɑ", "b", "ə"], ["m", "ɪ", "ç"], ["f", "ɛ", "ɾ", "ɪ", "ɾ", "t"]]},
  {"text": "Wo ist die Bushaltestelle?", "gloss": "Where is the bus stop?", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-004.txt", "ipa": [["v", "o"], ["ɪ", "s", "t"], ["d", "i"], ["b", "ʊ", "s", "h", "a", "l", "t", "ɛ", "ʃ", "t", "ɛ", "l", "ə"]]},
  {"text": "Der Zug ist verspätet", "gloss": "The train is late", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-004.txt", "ipa": [["d", "ɛ", "ɾ"], ["t", "s", "u", "k"], ["ɪ", "s", "t"], ["f", "ɛ", "ɾ", "ʃ", "p", "ɛ", "t", "ə", "t"]]},
  {"text": "Für wie viele Nächte?", "gloss": "For how many nights?", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-004.txt", "ipa": [["f", "y", "ɾ"], ["v", "i"], ["f", "i", "l", "ə"], ["n", "ɛ", "ç", "t", "ə"]]},
  {"text": "Können Sie mich um sieben Uhr wecken?", "gloss": "Can you wake me at seven o'clock?", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-004.txt", "ipa": [["k", "œ", "n", "ə", "n"], ["z", "i"], ["m", "ɪ", "ç"], ["ʊ", "m"], ["z", "i", "b", "ə", "n"], ["u", "ɾ"], ["v", "ɛ", "k", "ə", "n"]]},
  {"text": "Einen Tisch für zwei Personen, bitte", "gloss": "A table for two people", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-004.txt", "ipa": [["a", "ɪ", "n", "ə", "n"], ["t", "ɪ", "ʃ"], ["f", "y", "ɾ"], ["t", "s", "v", "a", "ɪ"], ["p", "ɛ", "ɾ", "z", "o", "n", "ə", "n"], ["b", "ɪ", "t", "ə"]]},
  {"text": "Ich bin allergisch gegen Erdnüsse", "gloss": "I'm allergic to peanuts", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-004.txt", "ipa": [["ɪ", "ç"], ["b", "ɪ", "n"], ["a", "l", "ɜ", "ɡ", "ɪ", "ʃ"], ["ɡ", "e", "ɡ", "ə", "n"], ["ɛ", "ɾ", "d", "n", "y", "s", "ə"]]},
  {"text": "Kann ich mit Karte zahlen?", "gloss": "Can I pay by card?", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-004.txt", "ipa": [["k", "a", "n"], ["ɪ", "ç"], ["m", "ɪ", "t"], ["k", "a", "ɾ", "t", "ə"], ["t", "s", "ɑ", "l", "ə", "n"]]},
  {"text": "Haben Sie eine größere Größe?", "gloss": "Do you have a larger size?", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-004.txt", "ipa": [["h", "ɑ", "b", "ə", "n"], ["z", "i"], ["a", "ɪ", "n", "ə"], ["ɡ", "ɾ", "ø", "s", "ə", "r", "ə"], ["ɡ", "ɾ", "ø", "s", "ə"]]},
  {"text": "Können Sie das als Geschenk verpacken?", "gloss": "Can you gift-wrap it?", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-004.txt", "ipa": [["k", "œ", "n", "ə", "n"], ["z", "i"], ["d", "a", "s"], ["a", "l", "s"], ["ɡ", "ə", "ʃ", "ɛ", "ŋ", "k"], ["f", "ɛ", "ɾ", "p", "a", "k", "ə", "n"]]},
  {"text": "Ich habe Bauchschmerzen", "gloss": "I have a stomachache", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-004.txt", "ipa": [["ɪ", "ç"], ["h", "ɑ", "b", "ə"], ["b", "a", "ʊ", "x", "ʃ", "m", "ɜ", "t", "s", "ə", "n"]]},
  {"text": "Ich brauche ein Rezept", "gloss": "I need a prescription", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-004.txt", "ipa": [["ɪ", "ç"], ["b", "ɾ", "a", "ʊ", "x", "ə"], ["a", "ɪ", "n"], ["r", "e", "t", "s", "ɛ", "p", "t"]]},
  {"text": "Ich möchte einen Termin vereinbaren", "gloss": "I would like to make an appointment", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-005.txt", "ipa": [["ɪ", "ç"], ["m", "œ", "ç", "t", "ə"], ["a", "ɪ", "n", "ə", "n"], ["t", "ɛ", "ɾ", "m", "i", "n"], ["f", "ɛ", "ɾ", "a", "ɪ", "n", "b", "ɑ", "r", "ə", "n"]]},
  {"text": "Gibt es Stornogebühren?", "gloss": "Are there cancellation fees?", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-005.txt", "ipa": [["ɡ", "i", "p", "t"], ["ɛ", "s"], ["ʃ", "t", "ɔ", "ɾ", "n", "o", "ɡ", "e", "b", "y", "r", "ə", "n"]]},
  {"text": "Wann ist der nächste Flug?", "gloss": "When is the next flight?", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-005.txt", "ipa": [["v", "a", "n"], ["ɪ", "s", "t"], ["d", "ɛ", "ɾ"], ["n", "ɛ", "ç", "s", "t", "ə"], ["f", "l", "u", "k"]]},
  {"text": "Ich möchte eine Beschwerde einreichen", "gloss": "I would like to file a complaint", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-005.txt", "ipa": [["ɪ", "ç"], ["m", "œ", "ç", "t", "ə"], ["a", "ɪ", "n", "ə"], ["b", "ə", "ʃ", "v", "e", "ɾ", "d", "ə"], ["a", "ɪ", "n", "r", "a", "ɪ", "ç", "ə", "n"]]},
  {"text": "Ich suche eine Wohnung zur Miete", "gloss": "I'm looking for an apartment to rent", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-005.txt", "ipa": [["ɪ", "ç"], ["z", "u", "x", "ə"], ["a", "ɪ", "n", "ə"], ["v", "o", "n", "ʊ", "ŋ"], ["t", "s", "u", "ɾ"], ["m", "i", "t", "ə"]]},
  {"text": "Ist das Viertel sicher?", "gloss": "Is the neighborhood safe?", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-005.txt", "ipa": [["ɪ", "s", "t"], ["d", "a", "s"], ["f", "i", "ɾ", "t", "ə", "l"], ["z", "ɪ", "ç", "ɜ"]]},
  {"text": "Wann kann ich anfangen?", "gloss": "When can I start?", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-005.txt", "ipa": [["v", "a", "n"], ["k", "a", "n"], ["ɪ", "ç"], ["a", "n", "f", "a", "ŋ", "ə", "n"]]},
  {"text": "Gibt es monatliche Gebühren?", "gloss": "Are there monthly fees?", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-005.txt", "ipa": [["ɡ", "i", "p", "t"], ["ɛ", "s"], ["m", "o", "n", "ɑ", "t", "l", "ɪ", "ç", "ə"], ["ɡ", "ə", "b", "y", "r", "ə", "n"]]},
  {"text": "Wie lange dauert die Überweisung?", "gloss": "How long does the transfer take?", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-005.txt", "ipa": [["v", "i"], ["l", "a", "ŋ", "ə"], ["d", "a", "ʊ", "ɜ", "t"], ["d", "i"], ["y", "b", "ɜ", "v", "a", "ɪ", "z", "ʊ", "ŋ"]]},
  {"text": "Jemand hat meine Karte ohne Erlaubnis benutzt", "gloss": "Someone used my card without authorization", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-005.txt", "ipa": [["j", "e", "m", "a", "n", "t"], ["h", "a", "t"], ["m", "a", "ɪ", "n", "ə"], ["k", "a", "ɾ", "t", "ə"], ["o", "n", "ə"], ["ɛ", "ɾ", "l", "a", "ʊ", "b", "n", "ɪ", "s"], ["b", "ə", "n", "ʊ", "t", "s", "t"]]},
  {"text": "Der PIN-Code funktioniert nicht", "gloss": "The PIN code doesn't work", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-005.txt", "ipa": [["d", "ɛ", "ɾ"], ["p", "e", "i", "ɛ", "n", "k", "o", "t"], ["f", "ʊ", "ŋ", "k", "t", "s", "j", "o", "n", "i", "ɾ", "t"], ["n", "ɪ", "ç", "t"]]},
  {"text": "Ich möchte eine Versicherung abschließen", "gloss": "I would like to take out insurance", "gloss_language": "en", "source": "language_materials/de/phrases/phrases-005.txt", "ipa": [["ɪ", "ç"], ["m", "œ", "ç", "t", "ə"], ["a", "ɪ", "n", "ə"], ["f", "ɛ", "ɾ", "z", "ɪ", "ç", "ə", "r", "ʊ", "ŋ"], ["a", "p", "ʃ", "l", "i", "s", "ə", "n"]]}
