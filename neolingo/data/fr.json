  {"text": "Oui", "gloss": "Yes", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-001.txt", "ipa": [["w", "i"]]},
  {"text": "Bonsoir", "gloss": "Good evening", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-001.txt", "ipa": [["b", "ɔ̃", "s", "w", "a", "ʁ"]]},
  {"text": "Excusez-moi", "gloss": "Excuse me", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-001.txt", "ipa": [["ɛ", "k", "s", "k", "y", "z", "e", "m", "w", "a"]]},
  {"text": "Et vous?", "gloss": "And you? (formal)", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-001.txt", "ipa": [["e"], ["v", "u"]]},
  {"text": "Bonne soirée", "gloss": "Have a good evening", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-001.txt", "ipa": [["b", "ɔ", "n"], ["s", "w", "a", "ʁ", "e"]]},
  {"text": "D'accord", "gloss": "Okay / Agreed", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-001.txt", "ipa": [["d", "a", "k", "ɔ", "ʁ"]]},
  {"text": "Je ne sais pas", "gloss": "I don't know", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-001.txt", "ipa": [["ʒ", "ə"], ["n", "ə"], ["s", "ɛ"], ["p", "a"]]},
  {"text": "Attention", "gloss": "Watch out / Careful", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-001.txt", "ipa": [["a", "t", "ɑ̃", "s", "j", "ɔ̃"]]},
  {"text": "Santé", "gloss": "Cheers / Bless you", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-001.txt", "ipa": [["s", "ɑ̃", "t", "e"]]},
  {"text": "Bon courage", "gloss": "Good luck / Hang in there", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-001.txt", "ipa": [["b", "ɔ̃"], ["k", "u", "ʁ", "a", "ʒ"]]},
  {"text": "Avec plaisir", "gloss": "With pleasure", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-001.txt", "ipa": [["a", "v", "ɛ", "k"], ["p", "l", "ɛ", "z", "i", "ʁ"]]},
  {"text": "Un moment", "gloss": "One moment", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-001.txt", "ipa": [["œ̃"], ["m", "o", "m", "ɑ̃"]]},
  {"text": "Comment ça va?", "gloss": "How are you? (informal)", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-003.txt", "ipa": [["k", "ɔ", "m", "ɑ̃"], ["s", "a"], ["v", "a"]]},
  {"text": "Tu t'appelles comment?", "gloss": "What's your name? (informal)", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-003.txt", "ipa": [["t", "y"], ["t", "a", "p", "ɛ", "l"], ["k", "ɔ", "m", "ɑ̃"]]},
  {"text": "J'habite à Londres", "gloss": "I live in London", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-003.txt", "ipa": [["ʒ", "a", "b", "i", "t"], ["a"], ["l", "ɔ̃", "d", "ʁ"]]},
  {"text": "Je ne comprends pas", "gloss": "I don't understand", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-003.txt", "ipa": [["ʒ", "ə"], ["n", "ə"], ["k", "ɔ̃", "p", "ʁ", "ɑ̃"], ["p", "a"]]},
  {"text": "Qu'est-ce que c'est?", "gloss": "What is this?", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-003.txt", "ipa": [["k", "ɛ", "s"], ["k", "ə"], ["s", "ɛ"]]},
  {"text": "C'est où?", "gloss": "Where is it?", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-003.txt", "ipa": [["s", "ɛ", "t"], ["u"]]},
  {"text": "Tout droit", "gloss": "Straight ahead", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-003.txt", "ipa": [["t", "u"], ["d", "ʁ", "w", "a"]]},
  {"text": "À côté de", "gloss": "Next to", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-003.txt", "ipa": [["a"], ["k", "o", "t", "e"], ["d", "ə"]]},
  {"text": "Avez-vous...?", "gloss": "Do you have...?", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-003.txt", "ipa": [["a", "v", "e", "v", "u"]]},
  {"text": "Pouvez-vous m'aider?", "gloss": "Can you help me?", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-003.txt", "ipa": [["p", "u", "v", "e", "v", "u"], ["m", "ɛ", "d", "e"]]},
  {"text": "Aujourd'hui", "gloss": "Today", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-003.txt", "ipa": [["o", "ʒ", "u", "ʁ", "d", "y", "i"]]},
  {"text": "Plus tard", "gloss": "Later", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-003.txt", "ipa": [["p", "l", "y"], ["t", "a", "ʁ"]]},
  {"text": "Je suis perdu", "gloss": "I'm lost (m)", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-004.txt", "ipa": [["ʒ", "ə"], ["s", "y", "i"], ["p", "ɛ", "ʁ", "d", "y"]]},
  {"text": "Où est l'arrêt de bus?", "gloss": "Where is the bus stop?", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-004.txt", "ipa": [["u"], ["ɛ"], ["l", "a", "ʁ", "ɛ"], ["d", "ə"], ["b", "y", "s"]]},
  {"text": "Le train est en retard", "gloss": "The train is late", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-004.txt", "ipa": [["l", "ə"], ["t", "ʁ", "ɛ̃"], ["ɛ", "t"], ["ɑ̃"], ["ʁ", "ə", "t", "a", "ʁ"]]},
  {"text": "Pour combien de nuits?", "gloss": "For how many nights?", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-004.txt", "ipa": [["p", "u", "ʁ"], ["k", "ɔ̃", "b", "j", "ɛ̃"], ["d", "ə"], ["n", "y", "i"]]},
  {"text": "Pouvez-vous me réveiller à sept heures?", "gloss": "Can you wake me at seven o'clock?", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-004.txt", "ipa": [["p", "u", "v", "e", "v", "u"], ["m", "ə"], ["ʁ", "e", "v", "ɛ", "j", "e"], ["a"], ["s", "ɛ", "t"], ["œ", "ʁ"]]},
  {"text": "Une table pour deux personnes", "gloss": "A table for two people", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-004.txt", "ipa": [["y", "n"], ["t", "a", "b", "l"], ["p", "u", "ʁ"], ["d", "ø"], ["p", "ɛ", "ʁ", "s", "ɔ", "n"]]},
  {"text": "Je suis allergique aux arachides", "gloss": "I'm allergic to peanuts", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-004.txt", "ipa": [["ʒ", "ə"], ["s", "y", "i", "z"], ["a", "l", "ɛ", "ʁ", "ʒ", "i", "k"], ["o", "z"], ["a", "ʁ", "a", "ʃ", "i", "d"]]},
  {"text": "Je peux payer par carte?", "gloss": "Can I pay by card?", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-004.txt", "ipa": [["ʒ", "ə"], ["p", "ø"], ["p", "ɛ", "j", "e"], ["p", "a", "ʁ"], ["k", "a", "ʁ", "t"]]},
  {"text": "Avez-vous une taille plus grande?", "gloss": "Do you have a larger size?", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-004.txt", "ipa": [["a", "v", "e", "v", "u", "z"], ["y", "n"], ["t", "a", "j"], ["p", "l", "y"], ["ɡ", "ʁ", "ɑ̃", "d"]]},
  {"text": "Pouvez-vous faire un paquet-cadeau?", "gloss": "Can you gift-wrap it?", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-004.txt", "ipa": [["p", "u", "v", "e", "v", "u"], ["f", "ɛ", "ʁ"], ["œ̃"], ["p", "a", "k", "ɛ", "k", "a", "d", "o"]]},
  {"text": "J'ai mal au ventre", "gloss": "I have a stomachache", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-004.txt", "ipa": [["ʒ", "e"], ["m", "a", "l"], ["o"], ["v", "ɑ̃", "t", "ʁ"]]},
  {"text": "J'ai besoin d'une ordonnance", "gloss": "I need a prescription", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-004.txt", "ipa": [["ʒ", "e"], ["b", "ə", "z", "w", "ɛ̃"], ["d", "y", "n"], ["ɔ", "ʁ", "d", "ɔ", "n", "ɑ̃", "s"]]},
  {"text": "Je voudrais prendre rendez-vous", "gloss": "I would like to make an appointment", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-005.txt", "ipa": [["ʒ", "ə"], ["v", "u", "d", "ʁ", "ɛ"], ["p", "ʁ", "ɑ̃", "d", "ʁ"], ["ʁ", "ɑ̃", "d", "e", "v", "u"]]},
  {"text": "Y a-t-il des frais d'annulation?", "gloss": "Are there cancellation fees?", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-005.txt", "ipa": [["i"], ["a", "t", "i", "l"], ["d", "e"], ["f", "ʁ", "ɛ"], ["d", "a", "n", "y", "l", "a", "s", "j", "ɔ̃"]]},
  {"text": "Quand est le prochain vol?", "gloss": "When is the next flight?", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-005.txt", "ipa": [["k", "ɑ̃", "t"], ["ɛ"], ["l", "ə"], ["p", "ʁ", "o", "ʃ", "ɛ̃"], ["v", "ɔ", "l"]]},
  {"text": "Je voudrais déposer une réclamation", "gloss": "I would like to file a complaint", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-005.txt", "ipa": [["ʒ", "ə"], ["v", "u", "d", "ʁ", "ɛ"], ["d", "e", "p", "o", "z", "e"], ["y", "n"], ["ʁ", "e", "k", "l", "a", "m", "a", "s", "j", "ɔ̃"]]},
  {"text": "Je cherche un appartement à louer", "gloss": "I'm looking for an apartment to rent", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-005.txt", "ipa": [["ʒ", "ə"], ["ʃ", "ɛ", "ʁ", "ʃ"], ["œ̃", "n"], ["a", "p", "a", "ʁ", "t", "ə", "m", "ɑ̃"], ["a"], ["l", "w", "e"]]},
  {"text": "Le quartier est-il sûr?", "gloss": "Is the neighborhood safe?", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-005.txt", "ipa": [["l", "ə"], ["k", "a", "ʁ", "t", "j", "e"], ["ɛ", "t", "i", "l"], ["s", "yː", "ʁ"]]},
  {"text": "Quand puis-je commencer?", "gloss": "When can I start?", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-005.txt", "ipa": [["k", "ɑ̃"], ["p", "y", "i", "ʒ"], ["k", "ɔ", "m", "ɑ̃", "s", "e"]]},
  {"text": "Y a-t-il des frais mensuels?", "gloss": "Are there monthly fees?", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-005.txt", "ipa": [["i"], ["a", "t", "i", "l"], ["d", "e"], ["f", "ʁ", "ɛ"], ["m", "ɑ̃", "s", "y", "ɛ", "l"]]},
