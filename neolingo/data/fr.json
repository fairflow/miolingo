  {"text": "Quelqu'un a utilisé ma carte sans autorisation", "gloss": "Someone used my card without authorization", "gloss_language": "en", "source": "language_materials/fr/phrases/phrases-005.txt", "ipa": [["k", "ɛ", "l", "k", "œ̃"], ["a"], ["y", "t", "i", "l", "i", "z", "e"], ["m", "a"], ["k", "a", "ʁ", "t"], ["s", "ɑ̃", "z"], ["o", "t", "o", "ʁ", "i", "z", "a", "s", "j", "ɔ̃"]]},
